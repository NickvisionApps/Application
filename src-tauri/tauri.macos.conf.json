{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "org.nickvision.application",
  "app": {
    "windows": [
      {
        "visible": false,
        "width": 800,
        "height": 600,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 27
        }
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "icon": [
      "../resources/32x32.png",
      "../resources/128x128.png",
      "../resources/128x128@2x.png",
      "../resources/icon.icns",
      "../resources/icon.ico",
      "../resources/org.nickvision.application.icon"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
